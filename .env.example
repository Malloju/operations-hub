# Copy to server/.env  (never commit .env)
PORT=4000
# Transactions require a replica set (a single-node replica set is fine for dev)
MONGO_URI=mongodb://127.0.0.1:27017/newtonite?replicaSet=rs0&directConnection=true
MONGO_URI_TEST=mongodb://127.0.0.1:27017/newtonite_test?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
# Set false ONLY on a standalone mongod (loses atomicity guarantees, see ENGINEERING_DECISIONS.md)
USE_TRANSACTIONS=true
COOKIE_SECURE=false
